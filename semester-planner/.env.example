# PostgreSQL connection string (Neon/Supabase in production, local in dev)
DATABASE_URL="postgresql://planner:planner@127.0.0.1:5432/semester_planner"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Seed admin (read by `prisma db seed`; never commit real values)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Email notifications (optional — features degrade gracefully when unset)
RESEND_API_KEY=""
EMAIL_FROM="Semester Planner <noreply@example.com>"
